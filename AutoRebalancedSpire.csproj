<Project Sdk="Godot.NET.Sdk/4.5.1">
  <Import Project="./local.props" Condition="Exists('./local.props')" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AutoRebalancedSpire</RootNamespace>
    <AssemblyName>AutoRebalancedSpire</AssemblyName>
    <Version>1.0.0</Version>

    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT' and Exists('D:/Sponsored/Steam')">D:/Sponsored/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT' and Exists('D:/Steam')">D:/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == '' and '$(OS)' == 'Windows_NT'">$(MSBuildProgramFiles32)/Steam</SteamRoot>
    <SteamRoot Condition="'$(SteamRoot)' == ''">$(HOME)/.local/share/Steam</SteamRoot>
    <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(SteamRoot)/steamapps/common/Slay the Spire 2</Sts2Dir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(OS)' == 'Windows_NT'">$(Sts2Dir)/data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">$(SteamRoot)/steamapps/workshop/content/2868840</WorkshopDir>
    <RitsuWorkshopRoot Condition="'$(RitsuWorkshopRoot)' == ''">$(WorkshopDir)/3747602295</RitsuWorkshopRoot>
    <RitsuLibDir Condition="'$(RitsuLibDir)' == ''">$(RitsuWorkshopRoot)/lib/0.111.0</RitsuLibDir>
    <!-- RitsuLib 0.6.0 起，包自带 RitsuLib.References.props，DLL 拆成 compat/<游戏API版本>/ + shared/。
         包里有四个 compat 目录，props 的自动挑选分支不会触发，必须显式给出目标版本。
         props 不存在就退回 0.5.x 的单 DLL 布局。 -->
    <RitsuLibReferenceTarget Condition="'$(RitsuLibReferenceTarget)' == ''">0.111.0</RitsuLibReferenceTarget>
    <RitsuLibReferencesProps>$(RitsuWorkshopRoot)/RitsuLib.References.props</RitsuLibReferencesProps>

    <!-- 钉死的依赖。两者都从游戏 mods 目录读，不把别人的二进制放进本仓库。
         RebalancedSpire 原本在 workshop 目录（3747498062），已整份拷进 mods/ 钉住版本：
         工坊那边随时会更新，而这份适配是逐张牌对着某一个构建核出来的。 -->
    <CombatSolverDir Condition="'$(CombatSolverDir)' == ''">$(Sts2Dir)/mods/CombatSolver</CombatSolverDir>
    <RebalancedSpireDir Condition="'$(RebalancedSpireDir)' == ''">$(Sts2Dir)/mods/RebalancedSpire</RebalancedSpireDir>

    <ModOutputDir>$(Sts2Dir)/mods/AutoRebalancedSpire</ModOutputDir>
    <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
    <!-- 求解器和游戏都要放开内部成员：适配层要注册进求解器的内部注册表。 -->
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="CombatSolver" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="RebalancedSpire" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <Import Project="$(RitsuLibReferencesProps)" Condition="Exists('$(RitsuLibReferencesProps)')" />

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Reference Include="STS2-RitsuLib" HintPath="$(RitsuLibDir)/STS2-RitsuLib.dll" Private="false"
               Condition="!Exists('$(RitsuLibReferencesProps)')" />
    <Reference Include="CombatSolver" HintPath="$(CombatSolverDir)/CombatSolver.dll" Private="false" />
    <Reference Include="RebalancedSpire" HintPath="$(RebalancedSpireDir)/RebalancedSpire.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidatePinnedDependencies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="找不到 $(Sts2DataDir)/sts2.dll。请检查 SteamRoot 或 local.props。" />
    <Error Condition="!Exists('$(RitsuLibReferencesProps)') and !Exists('$(RitsuLibDir)/STS2-RitsuLib.dll')" Text="找不到当前游戏版本的 RitsuLib。请检查 SteamRoot、RitsuWorkshopRoot 或 local.props。" />
    <Error Condition="!Exists('$(CombatSolverDir)/CombatSolver.dll')" Text="找不到 $(CombatSolverDir)/CombatSolver.dll。请先构建并部署 CombatSolver。" />
    <Error Condition="!Exists('$(RebalancedSpireDir)/RebalancedSpire.dll')" Text="找不到 $(RebalancedSpireDir)/RebalancedSpire.dll。请把 RebalancedSpire 整份拷进游戏 mods 目录（原始出处是 Workshop 3747498062）。" />
  </Target>

  <!--
    针对哪一份 RebalancedSpire 核对过。核对是逐张牌读它的 OnPlay 替换写的，哈希一变就说明
    可能有牌的语义改了，但不让构建失败——运行期有 AdapterSelfCheck 兜底。
  -->
  <Target Name="VerifyRebalancedSpireHash" AfterTargets="ValidatePinnedDependencies">
    <GetFileHash Files="$(RebalancedSpireDir)/RebalancedSpire.dll" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="ActualRebalancedSpireHash" />
    </GetFileHash>
    <Warning Condition="'$(ActualRebalancedSpireHash.ToLowerInvariant())' != '$(VerifiedRebalancedSpireDllSha256)'"
             Text="正在对着一份没有逐条核对过的 RebalancedSpire 构建。核对过的是 $(VerifiedRebalancedSpireDllSha256)，实际是 $(ActualRebalancedSpireHash.ToLowerInvariant())。结构自检仍然会在加载时把关，但数值和语义的漂移它抓不到——换版本请重新核对每一张牌，并更新 src/PinnedTargets.cs。" />
  </Target>

  <PropertyGroup>
    <!-- RebalancedSpire v0.3.10-beta (Workshop 3747498062) -->
    <VerifiedRebalancedSpireDllSha256>cce7a199fce3c83acb52c749d625accb24d4a38060d63ee018c80a5c495dcd2b</VerifiedRebalancedSpireDllSha256>
  </PropertyGroup>

  <Target Name="CopyMod" AfterTargets="Build" Condition="'$(CopyModOnBuild)' == 'true'">
    <MakeDir Directories="$(ModOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/AutoRebalancedSpire.json" DestinationFolder="$(ModOutputDir)" />
  </Target>
</Project>
